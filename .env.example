# Copy this file to .env and fill in your own values. .env is git-ignored.
# Do not put real values in this file; it is committed to the repo.

# Contact email sent to Open Library in the User-Agent header (optional).
OPENLIBRARY_CONTACT_EMAIL=you@example.com

# Django secret key. Optional locally (a development-only key is used when unset);
# set a long random value anywhere else.
DJANGO_SECRET_KEY=change-me

# Debug mode (true/false). Defaults to true for local development.
DJANGO_DEBUG=true
